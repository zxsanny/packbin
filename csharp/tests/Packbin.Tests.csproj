<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- dotnet test -p:PackbinTarget=netstandard2.0 runs this suite against the netstandard2.0 build. -->
  <PropertyGroup Condition="'$(PackbinTarget)' == 'netstandard2.0'">
    <DefineConstants>$(DefineConstants);PACKBIN_NETSTANDARD2_0</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PackbinTarget)' == ''">
    <ProjectReference Include="..\Packbin.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PackbinTarget)' != ''">
    <ProjectReference Include="..\Packbin.csproj" SetTargetFramework="TargetFramework=$(PackbinTarget)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="compile-fail/**" />
    <None Include="compile-fail/**" />
  </ItemGroup>

</Project>