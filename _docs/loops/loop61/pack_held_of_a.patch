+// What a `when` or a flag bit asks of the walker that reaches it; pack_children and pack_one both
+// ask here, so the two kinds are decided in one place, as unpack's held_of does. Skip: nothing to
+// write. Inline: a `when` that holds, whose children are walked as part of the walker's own loop.
+// Bit: a flag bit that is present, whose child follows it.
+enum class Held : std::uint8_t { Skip, Inline, Bit };
+
+PACKBIN_NOINLINE
+Held held_of(Pack const& p, Field const& f, void* obj) {
+  if (f.kind == Kind::When)
+    return when_matches(p.t, f, obj) ? Held::Inline : Held::Skip;
+  return present(p.t, static_cast<std::size_t>(&f - p.t) + 1, obj) ? Held::Bit : Held::Skip;
